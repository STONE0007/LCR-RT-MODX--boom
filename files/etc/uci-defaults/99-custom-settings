#!/bin/sh

# 1. 锁定 Aurora 磨砂主题与简体中文（彻底清除 Bootstrap 残留节点）
uci set luci.main.mediaurlbase='/luci-static/aurora'
uci set luci.main.resourcebase='/luci-static/resources'
uci set luci.themes.Aurora='/luci-static/aurora'
uci delete luci.themes.Bootstrap 2>/dev/null || true
uci set luci.main.lang='zh_cn'
uci commit luci

# 2. 设置时区为亚洲上海（CST-8）与 NTP 授时
uci set system.@system[0].timezone='CST-8'
uci set system.@system[0].zonename='Asia/Shanghai'
uci delete system.@system[0].ntp_server 2>/dev/null || true
uci add_list system.@system[0].ntp_server='ntp.aliyun.com'
uci add_list system.@system[0].ntp_server='time1.cloud.tencent.com'

# 3. 内存 ZRAM 压缩配置（移植 TR3000 256MB 满血低延迟方案）
uci set system.@system[0].zram_size_mb='256'
uci set system.@system[0].zram_comp_algo='lz4'
uci set system.@system[0].zram_priority='100'
uci commit system

# 4. 必须彻底关闭硬件/软件流加速（确保 eBPF / Netkit 完整接管数据流量）
uci set firewall.@defaults[0].flow_offloading='0'
uci set firewall.@defaults[0].flow_offloading_hw='0'
uci commit firewall

# 5. 立即加载 sysctl.conf 网络与 BBR 调优参数
sysctl -p 2>/dev/null || true

# 6. 清理 LuCI 界面缓存
rm -rf /tmp/luci-indexcache /tmp/luci-modulecache

exit 0
